Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psucc", "[", " ", 
    RowBox[{
     RowBox[{"m_Integer", "?", "NonNegative"}], ",", " ", 
     RowBox[{"r_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"phi_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"varphi_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"s_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"delta1_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"delta2_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
      "psi", ",", " ", "dp", ",", " ", "dm", ",", " ", "cH", ",", " ", "cV", ",",
        " ", "post"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"mpacs", "[", " ", 
        RowBox[{"m", ",", " ", "r", ",", " ", "phi", ",", " ", "varphi"}], 
        "]"}]}], ";", " ", 
      RowBox[{"dp", " ", "=", " ", 
       RowBox[{
        RowBox[{"displacementMatrix", "[", " ", 
         RowBox[{"s", "/", "2"}], "]"}], " ", ".", " ", "psi"}]}], ";", " ", 
      RowBox[{"dm", " ", "=", " ", 
       RowBox[{
        RowBox[{"displacementMatrix", "[", " ", 
         RowBox[{
          RowBox[{"-", "s"}], "/", "2"}], "]"}], " ", ".", " ", "psi"}]}], ";",
       " ", 
      RowBox[{"cH", " ", "=", " ", 
       RowBox[{"Cos", "[", " ", 
        RowBox[{
         RowBox[{"N", "[", " ", 
          RowBox[{"delta2", ",", " ", "wp"}], "]"}], "/", "2"}], "]"}]}], ";",
       " ", 
      RowBox[{"cV", " ", "=", " ", 
       RowBox[{
        RowBox[{"Exp", "[", " ", 
         RowBox[{"I", " ", 
          RowBox[{"N", "[", " ", 
           RowBox[{"delta1", ",", " ", "wp"}], "]"}]}], "]"}], " ", 
        RowBox[{"Sin", "[", " ", 
         RowBox[{
          RowBox[{"N", "[", " ", 
           RowBox[{"delta2", ",", " ", "wp"}], "]"}], "/", "2"}], "]"}]}]}], ";",
       " ", 
      RowBox[{"post", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"cH", " ", "+", " ", "cV"}], ")"}], " ", "dp"}], " ", "+",
           " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"cH", " ", "-", " ", "cV"}], ")"}], " ", "dm"}]}], ")"}], 
        "/", "2"}]}], ";", " ", 
      RowBox[{"N", "[", " ", 
       RowBox[{
        RowBox[{"Chop", "[", " ", 
         RowBox[{
          RowBox[{"Re", "[", " ", 
           RowBox[{
            RowBox[{"Conjugate", "[", " ", "post", "]"}], " ", ".", " ", 
            "post"}], "]"}], ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "25"}]}]}], "]"}], ",", " ", "16"}], "]"}]}]}], " ", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999409799440316*^9, 3.9994098281776876`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"4ae539d0-2d1e-475e-906d-b74815e2b8f3"]
}, Open  ]],

