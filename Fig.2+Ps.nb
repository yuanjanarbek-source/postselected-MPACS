Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displacementMatrix", "[", " ", 
    RowBox[{"beta_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"displacementMatrix", "[", " ", "beta", "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"b", " ", "=", " ", 
