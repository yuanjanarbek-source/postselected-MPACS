Cell[CellGroupData[{

Cell["2. Coherent, Cat, and Photon-Added States", 
         "Section", ExpressionUUID -> 
          "ae13fde9-207b-403c-8078-3f569eb7fb44"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherentState", "[", " ", 
    RowBox[{"alpha_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"coherentState", "[", " ", "alpha", "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"z", " ", "=", " ", 
        RowBox[{"N", "[", " ", 
         RowBox[{"alpha", ",", " ", "wp"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"Normalize", "[", " ", 
       RowBox[{"Table", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", " ", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"Abs", "[", " ", "z", "]"}], "^", "2"}]}], "/", "2"}], 
           "]"}], " ", 
          RowBox[{
           RowBox[{"z", "^", "n"}], "/", 
           RowBox[{"Sqrt", "[", " ", 
            RowBox[{"n", "!"}], "]"}]}]}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"dim", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}]}], 
     " ", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999409799410338*^9, 3.999409828174816*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"57e39129-9d4e-43dd-895f-00eb582ffd9f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"catState", "[", " ", 
    RowBox[{
     RowBox[{"r_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"phi_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"varphi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"catState", "[", " ", 
     RowBox[{"r", ",", " ", "phi", ",", " ", "varphi"}], "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"alpha", " ", "=", " ", 
        RowBox[{"N", "[", " ", 
         RowBox[{
          RowBox[{"r", " ", 
           RowBox[{"Exp", "[", " ", 
            RowBox[{"I", " ", "phi"}], "]"}]}], ",", " ", "wp"}], "]"}]}], 
       "}"}], ",", " ", 
      RowBox[{"Normalize", "[", " ", 
       RowBox[{
        RowBox[{"coherentState", "[", " ", "alpha", "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Exp", "[", " ", 
          RowBox[{"I", " ", 
           RowBox[{"N", "[", " ", 
            RowBox[{"varphi", ",", " ", "wp"}], "]"}]}], "]"}], " ", 
         RowBox[{"coherentState", "[", " ", 
          RowBox[{"-", "alpha"}], "]"}]}]}], "]"}]}], " ", "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.999409799420785*^9, 3.9994098281757793`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"898d98c7-6f87-4f48-b61a-1d6847253259"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mpacs", "[", " ", 
    RowBox[{
     RowBox[{"m_Integer", "?", "NonNegative"}], ",", " ", 
     RowBox[{"r_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"phi_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"varphi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
