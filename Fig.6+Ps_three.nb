           RowBox[{RowBox[{"\[Psi]i", "[", RowBox[{"m", ",", "r", ",", 
                 "\[CurlyPhi]", ",", "\[Phi]"}], "]"}], "=", 
             RowBox[{RowBox[{"Nest", "[", RowBox[{RowBox[{RowBox[
                      {SuperscriptBox[RowBox[{"AnnihilationOperator", "[", 
                          "]"}], "\[Dagger]"], "@", "#"}], "&"}], ",", 
