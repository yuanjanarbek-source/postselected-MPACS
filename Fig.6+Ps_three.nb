Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"X1", ",", "X2"}], "}"}], "=", 
   RowBox[{"QuadratureOperators", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"X", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"X", "[", "\[Theta]", "]"}], "=", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "X1"}], "+", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "X2"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]i", "[", 
     RowBox[{"m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Psi]i", "[", 
      RowBox[{"m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]"}], "]"}], "=", 
     
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"AnnihilationOperator", "[", "]"}], "\[Dagger]"], "@", 
          "#"}], "&"}], ",", 
        RowBox[{
         RowBox[{"CatState", "[", "]"}], "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\[FormalAlpha]", "->", 
            RowBox[{"N", "[", 
             RowBox[{"r", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"\[FormalPhi]", "->", 
            RowBox[{"N", "[", "\[Phi]", "]"}]}]}], "|>"}], "]"}], ",", "m"}], 
       "]"}], "[", "\"\<Normalize\>\"", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"displaced", "[", 
     RowBox[{
     "m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_", ",", "s_"}], "]"}],
     ":=", 
    RowBox[{
     RowBox[{"displaced", "[", 
      RowBox[{"m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]", ",", "s"}], 
      "]"}], "=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Psi]", "=", 
         RowBox[{"\[Psi]i", "[", 
          RowBox[{"m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]"}], "]"}]}],
         "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"DisplacementOperator", "[", "#", "]"}], "@", "\[Psi]"}], 
         "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", "s", "]"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"N", "[", "s", "]"}]}], "/", "2"}]}], "}"}]}]}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPhi]", "[", 
     RowBox[{
     "m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_", ",", "s_", ",", 
      "\[Delta]1_", ",", "\[Delta]2_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", "=", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"N", "[", "\[Delta]1", "]"}]}], "]"}], " ", 
          RowBox[{"Tan", "[", 
           RowBox[{
            RowBox[{"N", "[", "\[Delta]2", "]"}], "/", "2"}], "]"}]}]}], ",", 
        
        RowBox[{"ab", "=", 
         RowBox[{"displaced", "[", 
          RowBox[{
          "m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]", ",", "s"}], 
          "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "w"}], ")"}], " ", 
          RowBox[{"ab", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "w"}], ")"}], " ", 
          RowBox[{"ab", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "[", "\"\<Normalize\>\"",
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dX2", "[", 
     RowBox[{
     "m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_", ",", "s_", ",", 
      "\[Delta]1_", ",", "\[Delta]2_", ",", "\[Theta]_"}], "]"}], ":=", 
    RowBox[{"Re", "@", 
     RowBox[{"OperatorVariance", "[", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "[", 
        RowBox[{
        "m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]", ",", "s", ",", 
         "\[Delta]1", ",", "\[Delta]2"}], "]"}], ",", 
       RowBox[{"X", "[", "\[Theta]", "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"psucc", "[", 
    RowBox[{
    "m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_", ",", "s_", ",", 
     "\[Delta]1_", ",", "\[Delta]2_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"N", "[", "\[Delta]1", "]"}]}], "]"}], " ", 
         RowBox[{"Tan", "[", 
          RowBox[{
           RowBox[{"N", "[", "\[Delta]2", "]"}], "/", "2"}], "]"}]}]}], ",", 
       RowBox[{"ab", "=", 
        RowBox[{"displaced", "[", 
         RowBox[{"m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]", ",", "s"}],
          "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{
          RowBox[{"N", "[", "\[Delta]2", "]"}], "/", "2"}], "]"}], "^", "2"}],
        "/", "4"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "w"}], ")"}], " ", 
            RowBox[{"ab", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "w"}], ")"}], " ", 
            RowBox[{"ab", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "[", "\"\<Norm\>\"", 
         "]"}], ")"}], "^", "2"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9980497653704243`*^9, 3.9980497765399113`*^9}, {
   3.9980501826646404`*^9, 3.9980502248783417`*^9}, 3.9980502721946926`*^9},
