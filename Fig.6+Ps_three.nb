                      {"<|", RowBox[{RowBox[{"\[FormalAlpha]", "->", RowBox[
                          {"N", "[", RowBox[{"r", " ", RowBox[{"Exp", "[", 
                          RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}]}], 
                          "]"}]}], ",", RowBox[{"\[FormalPhi]", "->", RowBox[
                          {"N", "[", "\[Phi]", "]"}]}]}], "|>"}], "]"}], ",", 
