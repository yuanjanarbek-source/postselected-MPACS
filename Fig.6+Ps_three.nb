Cell[BoxData[{
 RowBox[{
  RowBox[{"Nm", "[", 
   RowBox[{"m_", ",", "\[Alpha]_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"m", "!"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"LaguerreL", "[", 
      RowBox[{"m", ",", 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2"]}]}], "]"}], "+", 
     RowBox[{
      RowBox[{"LaguerreL", "[", 
       RowBox[{"m", ",", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2"]}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2"]}], "]"}], " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vonNeumann", "[", 
    RowBox[{
    "m_", ",", "r_", ",", "\[CurlyPhi]_", ",", "\[Phi]_", ",", "s_", ",", 
     "\[Delta]1_", ",", "\[Delta]2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"AnnihilationOperator", "[", "]"}]}], ",", "f", ",", "u"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          FractionBox[
           RowBox[{"N", "[", "\[Delta]2", "]"}], "2"], "]"}], ",", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            RowBox[{"N", "[", "\[Delta]1", "]"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"N", "[", "\[Delta]2", "]"}], "2"], "]"}]}]}], "}"}]}], ";", 
      RowBox[{"u", "=", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"N", "[", "s", "]"}], " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}], "-", "a"}], ")"}], 
             "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "f", "]"}], ".", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"u", ".", 
           RowBox[{"Flatten", "[", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"Normal", "[", 
               RowBox[{
                RowBox[{"\[Psi]i", "[", 
                 RowBox[{"m", ",", "r", ",", "\[CurlyPhi]", ",", "\[Phi]"}], 
                 "]"}], "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "]"}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "$FockSize"}], "}"}]}], "]"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
