Cell[CellGroupData[{

Cell["8. Density-Plot Format", "Section",ExpressionUUID->"edd155c9-3a7f-47c0-b8dd-8ce8a599bb76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tnr", "=", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"#", ",", "#2", ",", "Bold", ",", "Black", ",", 
      RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}], 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makePlot", "[", 
    RowBox[{"fun_", ",", "lab_", ",", "s_", ",", 
     RowBox[{"{", 
      RowBox[{"showX_", ",", "showY_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"padL", "=", 
        RowBox[{"If", "[", 
         RowBox[{"showY", ",", "100", ",", "5"}], "]"}]}], ",", 
       RowBox[{"padB", "=", 
        RowBox[{"If", "[", 
         RowBox[{"showX", ",", "95", ",", "5"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"fun", "[", 
        RowBox[{"x", ",", "p"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
       RowBox[{"PlotPoints", "->", "120"}], ",", 
       RowBox[{"ColorFunction", "->", "seismicCF"}], ",", 
       RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotRangePadding", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", 
          RowBox[{"AbsoluteThickness", "[", "2.2", "]"}]}], "]"}]}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"showY", ",", "Automatic", ",", "blankTicks"}], "]"}], ",",
             "blankTicks"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"showX", ",", "Automatic", ",", "blankTicks"}], "]"}], ",",
             "blankTicks"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"showY", ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<p\>\"", ",", "35", ",", "Bold", ",", "Black"}], 
               "]"}], ",", "None"}], "]"}], ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"showX", ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<x\>\"", ",", "35", ",", "Bold", ",", "Black"}], 
               "]"}], ",", "None"}], "]"}], ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "30"}], "]"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Bold", ",", "1"}], "]"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"tnr", "[", 
             RowBox[{"lab", ",", "40"}], "]"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.13", ",", "0.88"}], "}"}], "]"}]}], "]"}], ",", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"tnr", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<s\>\"", ",", "Italic"}], "]"}], 
                 ",", "\"\< = \>\"", ",", "s"}], "}"}], "]"}], ",", "40"}], 
             "]"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", "0.88"}], "}"}], "]"}]}], "]"}]}], "}"}]}], 
       ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"ImagePadding", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"padL", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"padB", ",", "5"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"305", "+", "padL"}], ",", 
          RowBox[{"305", "+", "padB"}]}], "}"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9998656949781723`*^9, 3.999865694983938*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"8fe689b1-28d5-c34c-83a5-de7df7a12bb4"]
