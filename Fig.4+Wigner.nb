Cell[BoxData[{
 RowBox[{
  RowBox[{"legend", "=", 
   RowBox[{"BarLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"seismicCF", ",", "wrange"}], "}"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
