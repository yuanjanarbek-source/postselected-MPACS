Cell[CellGroupData[{

Cell["2. Photon-Added Cat State", "Section",ExpressionUUID->"c181fd46-76f5-4997-b572-2ffa7b1679cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999863816324087*^9, 3.999863816324087*^9}, {
  3.9998638556794567`*^9, 3.9998638822984524`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"2ab24231-8915-1c42-9ed8-06e2009db713"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"psi", "[", 
     RowBox[{"m_", ",", "r_", ",", "phi_", ",", "cphi_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"psi", "[", 
      RowBox[{"m", ",", "r", ",", "phi", ",", "cphi"}], "]"}], "=", 
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{"CatState", "[", "]"}], "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\[FormalAlpha]", "->", 
            RowBox[{"N", "[", 
             RowBox[{"r", " ", 
              RowBox[{"E", "^", 
               RowBox[{"(", 
                RowBox[{"I", " ", "phi"}], ")"}]}]}], "]"}]}], ",", 
           RowBox[{"\[FormalPhi]", "->", 
            RowBox[{"N", "[", "cphi", "]"}]}]}], "|>"}], "]"}], ",", "m"}], 
       "]"}], "[", "\"\<Normalize\>\"", "]"}]}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.999863816324087*^9, 3.999863816324087*^9}, {
  3.9998638556794567`*^9, 3.9998638822984524`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"1193b8c5-1448-b840-9d3d-b4f759fcb978"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Displaced and Postselected States", "Section",ExpressionUUID->"9e7f291e-5eef-43c0-95ad-735864e2bcfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displaced", "[", 
    RowBox[{"m_", ",", "r_", ",", "phi_", ",", "cphi_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"displaced", "[", 
     RowBox[{"m", ",", "r", ",", "phi", ",", "cphi", ",", "s"}], "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"DisplacementOperator", "[", "#", "]"}], "[", 
        RowBox[{"psi", "[", 
         RowBox[{"m", ",", "r", ",", "phi", ",", "cphi"}], "]"}], "]"}], 
       "[", "\"\<StateVector\>\"", "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"N", "[", "s", "]"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"N", "[", "s", "]"}]}], "/", "2"}]}], "}"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9998639049384727`*^9, 3.999863930600008*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"ab8b01f5-6293-8a48-b81b-712953372fdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Phi", "[", 
    RowBox[{
    "m_", ",", "r_", ",", "phi_", ",", "cphi_", ",", "s_", ",", "d1_", ",", 
     "d2_"}], "]"}], ":=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "+", "#"}], ",", 
           RowBox[{"1", "-", "#"}]}], "}"}], ".", 
         RowBox[{"displaced", "[", 
          RowBox[{"m", ",", "r", ",", "phi", ",", "cphi", ",", "s"}], "]"}]}],
         "]"}], "&"}], "[", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"I", " ", 
          RowBox[{"N", "[", "d1", "]"}]}], ")"}]}], " ", 
       RowBox[{"Tan", "[", 
        RowBox[{
         RowBox[{"N", "[", "d2", "]"}], "/", "2"}], "]"}]}], "]"}], ",", 
     "80"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9998639049384727`*^9, 3.999863950769764*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"b6484592-f3d4-1a45-b117-6163cd369cf1"]
}, Open  ]],

