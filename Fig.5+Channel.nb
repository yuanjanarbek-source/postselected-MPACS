Cell[CellGroupData[{

Cell["2. Coherent and Photon-Added Cat States", "Section",ExpressionUUID->"60b6b801-da47-4ee5-92ef-29fcc6acf47b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherentState", "[", " ", 
    RowBox[{"beta_", ",", " ", "dim_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nn", ",", " ", "psi"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"nn", " ", "=", " ", 
       RowBox[{"Range", "[", " ", 
        RowBox[{"0", ",", " ", 
         RowBox[{"dim", " ", "-", " ", "1"}]}], "]"}]}], ";", " ", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"N", "[", " ", 
        RowBox[{
         RowBox[{"Exp", "[", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"Abs", "[", " ", "beta", "]"}], "^", "2"}]}], "/", "2"}],
           "]"}], "*", 
         RowBox[{
          RowBox[{"beta", "^", "nn"}], "/", 
          RowBox[{"Sqrt", "[", " ", 
           RowBox[{"N", "[", " ", 
            RowBox[{"Factorial", "[", " ", "nn", "]"}], "]"}], "]"}]}]}], 
        "]"}]}], ";", " ", 
      RowBox[{"psi", "/", 
       RowBox[{"Norm", "[", " ", "psi", "]"}]}]}]}], " ", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999404240290246*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"33f5964b-5fd2-4e27-9a3b-8df22372c82a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"applyCreation", "[", " ", "psi_List", "]"}], " ", ":=", " ", 
   RowBox[{"Prepend", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", " ", 
       RowBox[{"N", "[", " ", 
        RowBox[{"Range", "[", " ", 
         RowBox[{
          RowBox[{"Length", "[", " ", "psi", "]"}], " ", "-", " ", "1"}], 
         "]"}], "]"}], "]"}], "*", 
      RowBox[{"Most", "[", " ", "psi", "]"}]}], ",", " ", 
     RowBox[{"0.", " ", "+", " ", 
      RowBox[{"0.", " ", "I"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9994042402931833`*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"2a6e28d3-128f-4540-a72c-e4f55ae78590"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mpacsState", "[", " ", 
    RowBox[{
    "amp_", ",", " ", "phase_", ",", " ", "mCat_Integer", ",", " ", 
     "dim_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", "psi", "}"}], ",", " ", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{
        RowBox[{"coherentState", "[", " ", 
         RowBox[{"amp", ",", " ", "dim"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Exp", "[", " ", 
          RowBox[{"I", "*", "phase"}], "]"}], "*", 
         RowBox[{"coherentState", "[", " ", 
          RowBox[{
           RowBox[{"-", "amp"}], ",", " ", "dim"}], "]"}]}]}]}], ";", " ", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"Nest", "[", " ", 
        RowBox[{"applyCreation", ",", " ", "psi", ",", " ", "mCat"}], "]"}]}],
       ";", " ", 
      RowBox[{"psi", "/", 
       RowBox[{"Norm", "[", " ", "psi", "]"}]}]}]}], " ", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999404240296562*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"990999ff-5360-4a31-b951-b1c5ac4a83b9"]
}, Open  ]],

