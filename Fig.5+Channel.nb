Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"initializePCG64", "[", " ", 
    RowBox[{"seed_Integer", " ", "/;", " ", 
     RowBox[{"seed", " ", ">=", " ", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "words", ",", " ", "initialState", ",", " ", "initialSequence"}], "}"}],
      ",", " ", 
     RowBox[{
      RowBox[{"words", " ", "=", " ", 
       RowBox[{"numpySeedWords", "[", " ", "seed", "]"}]}], ";", " ", 
      RowBox[{"initialState", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"words", "[", " ", 
          RowBox[{"[", " ", "1", "]"}], "]"}], "*", 
         RowBox[{"2", "^", "64"}]}], " ", "+", " ", 
        RowBox[{"words", "[", " ", 
         RowBox[{"[", " ", "2", "]"}], "]"}]}]}], ";", " ", 
      RowBox[{"initialSequence", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"words", "[", " ", 
          RowBox[{"[", " ", "3", "]"}], "]"}], "*", 
         RowBox[{"2", "^", "64"}]}], " ", "+", " ", 
        RowBox[{"words", "[", " ", 
         RowBox[{"[", " ", "4", "]"}], "]"}]}]}], ";", " ", 
      RowBox[{"pcgIncrement", " ", "=", " ", 
       RowBox[{"Mod", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "*", "initialSequence"}], " ", "+", " ", "1"}], ",", 
         " ", 
         RowBox[{"2", "^", "128"}]}], "]"}]}], ";", " ", 
      RowBox[{"pcgState", " ", "=", " ", 
       RowBox[{"Mod", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"pcgMultiplier", "*", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"pcgIncrement", " ", "+", " ", "initialState"}], ",", 
             " ", 
             RowBox[{"2", "^", "128"}]}], "]"}]}], " ", "+", " ", 
          "pcgIncrement"}], ",", " ", 
         RowBox[{"2", "^", "128"}]}], "]"}]}], ";"}]}], " ", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999404240389373*^9},
