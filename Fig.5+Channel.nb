Cell[CellGroupData[{

Cell["4. NumPy-Compatible Random Numbers", "Section",ExpressionUUID->"80c2f918-2c48-417e-bdd0-b5e2bc19b084"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"numpySeedWords", "[", " ", 
    RowBox[{"seed_Integer", " ", "/;", " ", 
     RowBox[{"seed", " ", ">=", " ", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"entropy", ",", " ", 
       RowBox[{"pool", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", " ", 
         RowBox[{"0", ",", " ", "4"}], "]"}]}], ",", " ", 
       RowBox[{"hc", " ", "=", " ", "16^^43b0d7e5"}], ",", " ", "hashmix", ",",
        " ", "mix", ",", " ", "words", ",", " ", "v"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"entropy", " ", "=", " ", 
       RowBox[{"Reverse", "[", " ", 
        RowBox[{"IntegerDigits", "[", " ", 
         RowBox[{"seed", ",", " ", 
          RowBox[{"2", "^", "32"}]}], "]"}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"hashmix", "[", " ", "value_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"BitXor", "[", " ", 
            RowBox[{"value", ",", " ", "hc"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"hc", " ", "=", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"hc", "*", "16^^931e8875"}], ",", " ", 
             RowBox[{"2", "^", "32"}]}], "]"}]}], ";", " ", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"z", "*", "hc"}], ",", " ", 
             RowBox[{"2", "^", "32"}]}], "]"}]}], ";", " ", 
          RowBox[{"BitXor", "[", " ", 
           RowBox[{"z", ",", " ", 
            RowBox[{"BitShiftRight", "[", " ", 
             RowBox[{"z", ",", " ", "16"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
      " ", 
      RowBox[{
       RowBox[{"mix", "[", " ", 
        RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"z", " ", "=", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"16^^ca01f9dd", "*", "x"}], " ", "-", " ", 
              RowBox[{"16^^4973f715", "*", "y"}]}], ",", " ", 
             RowBox[{"2", "^", "32"}]}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"BitXor", "[", " ", 
          RowBox[{"z", ",", " ", 
           RowBox[{"BitShiftRight", "[", " ", 
            RowBox[{"z", ",", " ", "16"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      " ", 
      RowBox[{"Do", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"pool", "[", " ", 
          RowBox[{"[", " ", "j", "]"}], "]"}], " ", "=", " ", 
         RowBox[{"hashmix", "[", " ", 
          RowBox[{"If", "[", " ", 
           RowBox[{
            RowBox[{"j", " ", "<=", " ", 
             RowBox[{"Length", "[", " ", "entropy", "]"}]}], ",", " ", 
            RowBox[{"entropy", "[", " ", 
             RowBox[{"[", " ", "j", "]"}], "]"}], ",", " ", "0"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "4"}], "}"}]}], "]"}], ";", " ", 
      RowBox[{"Do", "[", " ", 
       RowBox[{
        RowBox[{"If", "[", " ", 
         RowBox[{
          RowBox[{"j", " ", "!=", " ", "k"}], ",", " ", 
          RowBox[{
           RowBox[{"pool", "[", " ", 
            RowBox[{"[", " ", "k", "]"}], "]"}], " ", "=", " ", 
           RowBox[{"mix", "[", " ", 
            RowBox[{
             RowBox[{"pool", "[", " ", 
              RowBox[{"[", " ", "k", "]"}], "]"}], ",", " ", 
             RowBox[{"hashmix", "[", " ", 
              RowBox[{"pool", "[", " ", 
               RowBox[{"[", " ", "j", "]"}], "]"}], "]"}]}], "]"}]}]}], "]"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}], ";", " ", 
      RowBox[{"Do", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"pool", "[", " ", 
          RowBox[{"[", " ", "k", "]"}], "]"}], " ", "=", " ", 
         RowBox[{"mix", "[", " ", 
          RowBox[{
           RowBox[{"pool", "[", " ", 
            RowBox[{"[", " ", "k", "]"}], "]"}], ",", " ", 
           RowBox[{"hashmix", "[", " ", 
            RowBox[{"entropy", "[", " ", 
             RowBox[{"[", " ", "j", "]"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "5", ",", " ", 
          RowBox[{"Length", "[", " ", "entropy", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}], ";", " ", 
      RowBox[{"hc", " ", "=", " ", "16^^8b51f9dd"}], ";", " ", 
      RowBox[{"words", " ", "=", " ", 
       RowBox[{"Table", "[", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"v", " ", "=", " ", 
           RowBox[{"BitXor", "[", " ", 
            RowBox[{
             RowBox[{"pool", "[", " ", 
              RowBox[{"[", " ", 
               RowBox[{
                RowBox[{"Mod", "[", " ", 
                 RowBox[{
                  RowBox[{"j", " ", "-", " ", "1"}], ",", " ", "4"}], "]"}], 
                " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", "hc"}], "]"}]}],
           ";", " ", 
          RowBox[{"hc", " ", "=", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"hc", "*", "16^^58f38ded"}], ",", " ", 
             RowBox[{"2", "^", "32"}]}], "]"}]}], ";", " ", 
          RowBox[{"v", " ", "=", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"v", "*", "hc"}], ",", " ", 
             RowBox[{"2", "^", "32"}]}], "]"}]}], ";", " ", 
          RowBox[{"BitXor", "[", " ", 
           RowBox[{"v", ",", " ", 
            RowBox[{"BitShiftRight", "[", " ", 
             RowBox[{"v", ",", " ", "16"}], "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "8"}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", " ", 
           RowBox[{"[", " ", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"2", "^", "32"}], "*", 
           RowBox[{"#", "[", " ", 
            RowBox[{"[", " ", "2", "]"}], "]"}]}]}], " ", "&"}], ")"}], " ", "/@",
        " ", 
       RowBox[{"Partition", "[", " ", 
