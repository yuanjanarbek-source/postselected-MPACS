Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"numpyRandom", "[", " ", 
    RowBox[{"count_Integer", "?", "Positive"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coef", ",", " ", "states", ",", " ", "values", ",", " ", "rotations", ",",
        " ", "bits"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"coef", " ", "=", " ", 
       RowBox[{"pcgBatchCoefficients", "[", " ", "count", "]"}]}], ";", " ", 
      RowBox[{"states", " ", "=", " ", 
       RowBox[{"Mod", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"coef", "[", " ", 
            RowBox[{"[", " ", "1", "]"}], "]"}], "*", "pcgState"}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"coef", "[", " ", 
            RowBox[{"[", " ", "2", "]"}], "]"}], "*", "pcgIncrement"}]}], ",",
          " ", 
         RowBox[{"2", "^", "128"}]}], "]"}]}], ";", " ", 
      RowBox[{"pcgState", " ", "=", " ", 
       RowBox[{"Last", "[", " ", "states", "]"}]}], ";", " ", 
      RowBox[{"values", " ", "=", " ", 
       RowBox[{"BitXor", "[", " ", 
        RowBox[{
         RowBox[{"BitShiftRight", "[", " ", 
          RowBox[{"states", ",", " ", "64"}], "]"}], ",", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"states", ",", " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], "]"}]}], ";", " ", 
      RowBox[{"rotations", " ", "=", " ", 
       RowBox[{"BitShiftRight", "[", " ", 
        RowBox[{"states", ",", " ", "122"}], "]"}]}], ";", " ", 
      RowBox[{"bits", " ", "=", " ", 
       RowBox[{"BitOr", "[", " ", 
        RowBox[{
         RowBox[{"BitShiftRight", "[", " ", 
          RowBox[{"values", ",", " ", "rotations"}], "]"}], ",", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{
           RowBox[{"BitShiftLeft", "[", " ", 
            RowBox[{"values", ",", " ", 
             RowBox[{"Mod", "[", " ", 
              RowBox[{
               RowBox[{"-", "rotations"}], ",", " ", "64"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"2", "^", "64"}]}], "]"}]}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"N", "[", " ", 
        RowBox[{"BitShiftRight", "[", " ", 
         RowBox[{"bits", ",", " ", "11"}], "]"}], "]"}], "/", 
       RowBox[{"2.", "^", "53"}]}]}]}], " ", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.999404240401729*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"5bc092b2-0d16-4940-84b3-fb80436e8469"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Sequential Measurement and Postselection", "Section",ExpressionUUID->"b55a7c9a-f7f3-41fd-b418-fa69df105c15"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"simulateAll", "[", " ", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", ",", " ", "q", ",", " ", 
       RowBox[{"rawData", " ", "=", " ", 
        RowBox[{"<|", "|>"}]}], ",", " ", "postData", ",", " ", "plus", ",", 
       " ", "minus", ",", " ", "pPlus", ",", " ", "pMinus", ",", " ", 
       "choosePlus", ",", " ", "norm", ",", " ", "xx", ",", " ", "pf", ",", 
       " ", "keep"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"initializePCG64", "[", " ", "seed", "]"}], ";", " ", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", " ", 
        RowBox[{"psiI", ",", " ", "nRaw"}], "]"}]}], ";", " ", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", " ", 
        RowBox[{"0", ",", " ", "nRaw"}], "]"}]}], ";", " ", 
      RowBox[{"postData", " ", "=", " ", 
       RowBox[{"Association", "@", 
        RowBox[{"Table", "[", " ", 
         RowBox[{
          RowBox[{"mCat", " ", "->", " ", 
           RowBox[{"<|", "|>"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"mCat", ",", " ", "mCatValues"}], "}"}]}], "]"}]}]}], ";", 
      " ", 
      RowBox[{"Do", "[", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"plus", " ", "=", " ", 
          RowBox[{"Transpose", "[", " ", 
           RowBox[{"mPlus", "*", 
            RowBox[{"Transpose", "[", " ", "psi", "]"}]}], "]"}]}], ";", " ", 
         
         RowBox[{"minus", " ", "=", " ", 
          RowBox[{"Transpose", "[", " ", 
           RowBox[{"mMinus", "*", 
            RowBox[{"Transpose", "[", " ", "psi", "]"}]}], "]"}]}], ";", " ", 
         
         RowBox[{"pPlus", " ", "=", " ", 
          RowBox[{"Re", "[", " ", 
           RowBox[{"Total", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", " ", "plus", "]"}], "^", "2"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"pMinus", " ", "=", " ", 
          RowBox[{"Re", "[", " ", 
           RowBox[{"Total", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", " ", "minus", "]"}], "^", "2"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"choosePlus", " ", "=", " ", 
          RowBox[{"MapThread", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Boole", "[", " ", 
              RowBox[{"#1", " ", "<", " ", "#2"}], "]"}], " ", "&"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"numpyRandom", "[", " ", "nRaw", "]"}], ",", " ", 
              RowBox[{"Clip", "[", " ", 
               RowBox[{"pPlus", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0.", ",", " ", "1."}], "}"}]}], "]"}]}], "}"}]}], 
           "]"}]}], ";", " ", 
         RowBox[{"norm", " ", "=", " ", 
          RowBox[{"Sqrt", "[", " ", 
           RowBox[{
            RowBox[{"choosePlus", "*", "pPlus"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "choosePlus"}], ")"}], "*", 
             "pMinus"}]}], "]"}]}], ";", " ", 
         RowBox[{"psi", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"choosePlus", "*", "plus"}], " ", "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "choosePlus"}], ")"}], "*", 
              "minus"}]}], ")"}], "/", "norm"}]}], ";", " ", 
         RowBox[{"q", " ", "+=", " ", "choosePlus"}], ";", " ", 
         RowBox[{"If", "[", " ", 
          RowBox[{
           RowBox[{"MemberQ", "[", " ", 
            RowBox[{"nMeasValues", ",", " ", "step"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"xx", " ", "=", " ", 
             RowBox[{
              RowBox[{"N", "[", " ", 
               RowBox[{"q", "/", "step"}], "]"}], " ", "-", " ", "0.5"}]}], ";",
             " ", 
            RowBox[{"AssociateTo", "[", " ", 
             RowBox[{"rawData", ",", " ", 
              RowBox[{"step", " ", "->", " ", "xx"}]}], "]"}], ";", " ", 
            RowBox[{"Do", "[", "  ", 
             RowBox[{
              RowBox[{
               RowBox[{"pf", " ", "=", " ", 
                RowBox[{"Clip", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", " ", 
                    RowBox[{"psi", ".", 
                    RowBox[{"Conjugate", "[", " ", 
                    RowBox[{"psiF", "[", " ", "mCat", "]"}], "]"}]}], "]"}], "^",
                    "2"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0.", ",", " ", "1."}], "}"}]}], "]"}]}], ";", " ", 
               RowBox[{"keep", " ", "=", " ", 
                RowBox[{"MapThread", "[", " ", 
                 RowBox[{"Less", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"numpyRandom", "[", " ", "nRaw", "]"}], ",", " ", 
                    "pf"}], "}"}]}], "]"}]}], ";", " ", 
               RowBox[{"AssociateTo", "[", " ", 
                RowBox[{"postData", ",", " ", 
                 RowBox[{"mCat", " ", "->", " ", 
                  RowBox[{"Append", "[", " ", 
                   RowBox[{
                    RowBox[{"postData", "[", " ", "mCat", "]"}], ",", " ", 
                    RowBox[{"step", " ", "->", " ", 
                    RowBox[{"Pick", "[", " ", 
                    RowBox[{"xx", ",", " ", "keep", ",", " ", "True"}], 
                    "]"}]}]}], "]"}]}]}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"mCat", ",", " ", "mCatValues"}], "}"}]}], "]"}]}]}], 
          " ", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"step", ",", " ", "1", ",", " ", 
          RowBox[{"Last", "[", " ", "nMeasValues", "]"}]}], "}"}]}], "]"}], ";",
       " ", 
      RowBox[{"{", 
       RowBox[{"rawData", ",", " ", "postData"}], "}"}]}]}], " ", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.99940424043001*^9},
 CellLabel->"In[33]:=",ExpressionUUID->"9a4eafa8-7d61-4eb7-b5c9-0966fdcbe1b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Histogram Heights and Gaussian Smoothing", "Section",ExpressionUUID->"c69e8064-738f-4d9d-a3b2-2bceb8cd0e81"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"heights", "[", " ", 
    RowBox[{"xx_List", ",", " ", "nMeas_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", ",", " ", "counts"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"Round", "[", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xx", " ", "+", " ", "0.5"}], ")"}], "*", "nMeas"}], 
        "]"}]}], ";", " ", 
      RowBox[{"counts", " ", "=", " ", 
       RowBox[{"Counts", "[", " ", "q", "]"}]}], ";", " ", 
      RowBox[{"N", "[", " ", 
       RowBox[{
        RowBox[{"Lookup", "[", " ", 
         RowBox[{"counts", ",", " ", 
          RowBox[{"Range", "[", " ", 
           RowBox[{"0", ",", " ", "nMeas"}], "]"}], ",", " ", "0"}], "]"}], "/",
         "nMeas"}], "]"}]}]}], " ", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.999404240431962*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"6b785cab-10c4-4309-a69f-d494133c81da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"smoothKernel", "[", " ", 
    RowBox[{
    "nMeas_Integer", ",", " ", "xCurve_List", ",", " ", "sigmaBins_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", " ", 
     RowBox[{
      RowBox[{"x", " ", "=", " ", 
       RowBox[{
        RowBox[{"N", "[", " ", 
         RowBox[{
          RowBox[{"Range", "[", " ", 
           RowBox[{"0", ",", " ", "nMeas"}], "]"}], "/", "nMeas"}], "]"}], 
        " ", "-", " ", "0.5"}]}], ";", " ", 
      RowBox[{
       RowBox[{"Exp", "[", " ", 
        RowBox[{
         RowBox[{"-", "0.5"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Outer", "[", " ", 
             RowBox[{"Subtract", ",", " ", "xCurve", ",", " ", "x"}], "]"}], "*", 
            RowBox[{"nMeas", "/", "sigmaBins"}]}], ")"}], "^", "2"}]}], "]"}],
        "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", " ", 
          RowBox[{"2.", "*", "Pi"}], "]"}], "*", "sigmaBins"}], ")"}]}]}]}], 
    " ", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.999404240433879*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"58efb414-9eeb-442c-b3ad-a097ceedc6fe"]
}, Open  ]],

