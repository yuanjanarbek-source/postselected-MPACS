Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pcgBatchCoefficients", "[", " ", "count_Integer", "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"pcgBatchCoefficients", "[", " ", "count", "]"}], " ", "=", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"Rest", "[", " ", 
       RowBox[{"NestList", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", " ", 
           RowBox[{
            RowBox[{"pcgMultiplier", "*", "#"}], ",", " ", 
            RowBox[{"2", "^", "128"}]}], "]"}], " ", "&"}], ",", " ", "1", ",",
          " ", "count"}], "]"}], "]"}], ",", " ", 
      RowBox[{"Rest", "[", " ", 
       RowBox[{"NestList", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"pcgMultiplier", "*", "#"}], " ", "+", " ", "1"}], ",", 
            " ", 
            RowBox[{"2", "^", "128"}]}], "]"}], " ", "&"}], ",", " ", "0", ",",
          " ", "count"}], "]"}], "]"}]}], "}"}]}]}], ";"}]], "Input",
