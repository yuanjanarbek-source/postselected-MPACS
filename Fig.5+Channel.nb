Cell[BoxData[
 RowBox[{
  RowBox[{"mPlus", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", " ", 
       RowBox[{
        RowBox[{"-", "I"}], "*", "t", "*", "n"}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Exp", "[", " ", 
        RowBox[{"I", "*", "deltaPhi"}], "]"}], "*", 
       RowBox[{"Exp", "[", " ", 
        RowBox[{"I", "*", "t", "*", "n"}], "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999404240301251*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"4edbd3eb-7a2d-4564-ac4b-0e572778502d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mMinus", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", " ", 
       RowBox[{
        RowBox[{"-", "I"}], "*", "t", "*", "n"}], "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Exp", "[", " ", 
        RowBox[{"I", "*", "deltaPhi"}], "]"}], "*", 
       RowBox[{"Exp", "[", " ", 
        RowBox[{"I", "*", "t", "*", "n"}], "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999404240302444*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"0db41328-5c4c-48eb-a1bf-1f0585f7abbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weakValues", " ", "=", " ", 
   RowBox[{"Association", "@", 
    RowBox[{"Table", "[", "  ", 
     RowBox[{
      RowBox[{"mCat", " ", "->", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", " ", 
           RowBox[{"psiF", "[", " ", "mCat", "]"}], "]"}], ".", 
          RowBox[{"(", 
