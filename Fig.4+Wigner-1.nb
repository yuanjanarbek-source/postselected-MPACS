Cell[CellGroupData[{

Cell["8. Density-Plot Format", "Section",ExpressionUUID->"edd155c9-3a7f-47c0-b8dd-8ce8a599bb76"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makePlot", "[", " ", 
    RowBox[{"fun_", ",", " ", "lab_", ",", " ", "sVal_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"showX_", ",", " ", "showY_"}], "}"}]}], "]"}], " ", ":=", " ", 
   
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"padL", " ", "=", " ", 
        RowBox[{"If", "[", " ", 
         RowBox[{"showY", ",", " ", "100", ",", " ", "5"}], "]"}]}], ",", " ", 
       RowBox[{"padB", " ", "=", " ", 
        RowBox[{"If", "[", " ", 
         RowBox[{"showX", ",", " ", "95", ",", " ", "5"}], "]"}]}]}], "}"}], ",",
      " ", 
     RowBox[{"DensityPlot", "[", " ", 
      RowBox[{
       RowBox[{"fun", "[", " ", 
        RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "120"}], ",", " ", 
       RowBox[{"ColorFunction", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"seismicCF", "[", " ", 
           RowBox[{"Rescale", "[", " ", 
            RowBox[{"#1", ",", " ", "wrange"}], "]"}], "]"}], " ", "&"}], " ",
          ")"}]}], ",", " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotRangePadding", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", " ", 
         RowBox[{"Black", ",", " ", 
          RowBox[{"AbsoluteThickness", "[", " ", "2.2", "]"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", " ", 
             RowBox[{"showY", ",", " ", "Automatic", ",", " ", "blankTicks"}],
              "]"}], ",", " ", "blankTicks"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", " ", 
             RowBox[{"showX", ",", " ", "Automatic", ",", " ", "blankTicks"}],
              "]"}], ",", " ", "blankTicks"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", " ", 
             RowBox[{"showY", ",", " ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{"\"\<p\>\"", ",", " ", "38", ",", " ", "Black"}], 
               "]"}], ",", " ", "None"}], "]"}], ",", " ", "None"}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", " ", 
             RowBox[{"showX", ",", " ", 
              RowBox[{"Style", "[", " ", 
               RowBox[{"\"\<x\>\"", ",", " ", "38", ",", " ", "Black"}], 
               "]"}], ",", " ", "None"}], "]"}], ",", " ", "None"}], "}"}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"FrameTicksStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", " ", 
         RowBox[{"Black", ",", " ", "34"}], "]"}]}], ",", " ", 
       RowBox[{"LabelStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", " ", 
         RowBox[{"Black", ",", " ", "1"}], "]"}]}], ",", " ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Text", "[", " ", 
           RowBox[{
            RowBox[{"Style", "[", " ", 
             RowBox[{"lab", ",", " ", "40", ",", "  ", "Black", ",", " ", 
              RowBox[{
              "FontFamily", " ", "->", " ", "\"\<Times New Roman\>\""}]}], 
             "]"}], ",", " ", 
            RowBox[{"Scaled", "[", " ", 
