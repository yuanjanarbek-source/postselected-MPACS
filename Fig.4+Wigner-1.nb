Cell[CellGroupData[{

Cell["2. Photon-Added Cat State", "Section",ExpressionUUID->"c181fd46-76f5-4997-b572-2ffa7b1679cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]i", "[", " ", 
    RowBox[{
    "m_", ",", " ", "r_", ",", " ", "\[Phi]_", ",", " ", "\[CurlyPhi]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"\[Psi]i", "[", " ", 
     RowBox[{
     "m", ",", " ", "r", ",", " ", "\[Phi]", ",", " ", "\[CurlyPhi]"}], "]"}],
     " ", "=", " ", 
    RowBox[{
     RowBox[{"Nest", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SuperDagger", "[", " ", 
          RowBox[{"AnnihilationOperator", "[", " ", "]"}], "]"}], "[", " ", 
         "#1", "]"}], " ", "&"}], " ", ",", " ", 
       RowBox[{
        RowBox[{"CatState", "[", " ", "]"}], "[", " ", 
        RowBox[{"Association", "[", " ", 
         RowBox[{
          RowBox[{"\[FormalAlpha]", " ", "->", " ", 
           RowBox[{"N", "[", " ", 
            RowBox[{"r", "*", 
             RowBox[{"Exp", "[", " ", 
              RowBox[{"I", "*", "\[Phi]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"\[FormalPhi]", " ", "->", " ", 
           RowBox[{"N", "[", " ", "\[CurlyPhi]", "]"}]}]}], "]"}], "]"}], ",",
        " ", "m"}], "]"}], "[", " ", "\"\<Normalize\>\"", "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.999400532008251*^9},
 CellLabel->"In[37]:=",ExpressionUUID->"eaf2f4fe-7aec-4df7-a5c2-65512b046ed4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Displaced and Postselected States", "Section",ExpressionUUID->"9e7f291e-5eef-43c0-95ad-735864e2bcfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displaced", "[", " ", 
    RowBox[{
    "m_", ",", " ", "r_", ",", " ", "\[Phi]_", ",", " ", "\[CurlyPhi]_", ",", 
     " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"displaced", "[", " ", 
     RowBox[{
     "m", ",", " ", "r", ",", " ", "\[Phi]", ",", " ", "\[CurlyPhi]", ",", 
      " ", "s"}], "]"}], " ", "=", " ", 
    RowBox[{"With", "[", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Psi]", " ", "=", " ", 
        RowBox[{"\[Psi]i", "[", " ", 
         RowBox[{
         "m", ",", " ", "r", ",", " ", "\[Phi]", ",", " ", "\[CurlyPhi]"}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"DisplacementOperator", "[", " ", "#1", "]"}], "[", " ", 
          "\[Psi]", "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", " ", "s", "]"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"N", "[", " ", "s", "]"}]}], "/", "2"}]}], "}"}]}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.999400532016048*^9},
 CellLabel->"In[38]:=",ExpressionUUID->"bd276f07-de94-44ac-94d3-521329506d05"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", " ", 
    RowBox[{
    "m_", ",", " ", "r_", ",", " ", "\[Phi]_", ",", " ", "\[CurlyPhi]_", ",", 
     " ", "s_", ",", " ", "\[Delta]1_", ",", " ", "\[Delta]2_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"With", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Aw", " ", "=", " ", 
        RowBox[{
         RowBox[{"Exp", "[", " ", 
          RowBox[{"I", "*", 
           RowBox[{"N", "[", " ", "\[Delta]1", "]"}]}], "]"}], "*", 
         RowBox[{"Tan", "[", " ", 
          RowBox[{
           RowBox[{"N", "[", " ", "\[Delta]2", "]"}], "/", "2"}], "]"}]}]}], ",",
        " ", 
       RowBox[{"ab", " ", "=", " ", 
        RowBox[{"displaced", "[", " ", 
         RowBox[{
         "m", ",", " ", "r", ",", " ", "\[Phi]", ",", " ", "\[CurlyPhi]", ",",
           " ", "s"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "Aw"}], ")"}], "*", 
         RowBox[{"ab", "[", " ", 
          RowBox[{"[", " ", "1", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "Aw"}], ")"}], "*", 
         RowBox[{"ab", "[", " ", 
          RowBox[{"[", " ", "2", "]"}], "]"}]}]}], ")"}], "[", 
      " ", "\"\<Normalize\>\"", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.999400532024585*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"0e4d59bf-59bb-47ce-a1b1-db574ba5aed9"]
}, Open  ]],

