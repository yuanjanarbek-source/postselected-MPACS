Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", " ", 
    RowBox[{
    "m_", ",", " ", "r_", ",", " ", "\[CurlyPhi]_", ",", " ", "\[Phi]_", ",", 
     " ", "s_", ",", " ", "\[Delta]1_", ",", " ", "\[Delta]2_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", " ", "=", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", 
           RowBox[{"N", "[", "\[Delta]1", "]"}]}], "]"}], "*", 
         RowBox[{"Tan", "[", 
          RowBox[{
           RowBox[{"N", "[", "\[Delta]2", "]"}], "/", "2"}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"ab", " ", "=", " ", 
        RowBox[{"displaced", "[", 
         RowBox[{
         "m", ",", " ", "r", ",", " ", "\[CurlyPhi]", ",", " ", "\[Phi]", ",",
           " ", "s"}], "]"}]}]}], "}"}], ",", " ", 
