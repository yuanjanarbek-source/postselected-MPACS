              RowBox[{"I", "*", "\[CurlyPhi]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"\[FormalPhi]", " ", "->", " ", 
           RowBox[{"N", "[", "\[Phi]", "]"}]}]}], "]"}], "]"}], ",", " ", 
       "m"}], "]"}], "[", "\"\<Normalize\>\"", "]"}]}]}], ";"}]], "Input",
