     "m", ",", " ", "r", ",", " ", "\[CurlyPhi]", ",", " ", "\[Phi]"}], "]"}],
     " ", "=", " ", 
    RowBox[{
     RowBox[{"Nest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SuperDagger", "[", 
          RowBox[{"AnnihilationOperator", "[", "]"}], "]"}], "[", "#1", "]"}],
         " ", "&"}], " ", ",", " ", 
       RowBox[{
        RowBox[{"CatState", "[", "]"}], "[", 
