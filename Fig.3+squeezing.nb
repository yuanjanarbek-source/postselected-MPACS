      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "w"}], ")"}], "*", 
         RowBox[{"ab", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "w"}], ")"}], "*", 
         RowBox[{"ab", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "[", "\"\<Normalize\>\"",
       "]"}]}], "]"}]}], ";"}]], "Input",
