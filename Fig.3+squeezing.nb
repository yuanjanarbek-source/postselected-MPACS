Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", " ", "\[Theta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"X", "[", "\[Theta]", "]"}], " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"AnnihilationOperator", "[", "]"}]}], "}"}], ",", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", "*", "\[Theta]"}], "]"}], "*", 
           RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "I"}], ")"}], "*", "\[Theta]"}], "]"}], "*", 
           RowBox[{
            RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}], "^", "2"}]}]}], 
         ")"}]}], "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.999379970092268*^9},
 CellLabel->
