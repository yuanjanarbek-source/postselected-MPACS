Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]i", "[", " ", 
    RowBox[{
    "m_", ",", " ", "r_", ",", " ", "\[CurlyPhi]_", ",", " ", "\[Phi]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
